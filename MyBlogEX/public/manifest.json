{
  "manifest_version": 3,
  "name": "My Blog Tarot Extension",
  "version": "1.0.0",
  "description": "Tarot card reading extension from My Blog System",
  "icons": {
    "16": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["locales/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "favicon.png",
      "32": "favicon.png",
      "128": "favicon.png"
    },
    "default_title": "My Blog Tarot Extension"
  },
  "permissions": ["cookies", "storage"],
  "host_permissions": ["http://localhost:5250/*", "http://localhost:3000/*"]
}
